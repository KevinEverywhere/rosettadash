{
  "name": "storybook-web-components",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/storybook-web-components/src",
  "tags": ["scope:storybook", "type:catalog"],
  "implicitDependencies": ["web-components"],
  "targets": {
    "storybook": {
      "executor": "@nx/storybook:storybook",
      "options": {
        "port": 6006,
        "configDir": "apps/storybook-web-components/.storybook",
        "ci": true
      }
    },
    "build-storybook": {
      "executor": "@nx/storybook:build",
      "outputs": ["{options.outputDir}"],
      "options": {
        "configDir": "apps/storybook-web-components/.storybook",
        "outputDir": "dist/storybook/storybook-web-components"
      }
    }
  }
}
