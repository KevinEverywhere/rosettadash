{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    ".storybook/**/*.ts",
