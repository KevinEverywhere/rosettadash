{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@dashbuilder/core": ["./packages/core/src/index.ts"],
      "@dashbuilder/ui-primitives": ["./packages/ui-primitives/src/index.ts"],
      "@dashbuilder/exporters-react": ["./packages/exporters-react/src/index.ts"],
      "@dashbuilder/exporters-nest": ["./packages/exporters-nest/src/index.ts"],
      "@dashbuilder/exporters-angular": ["./packages/exporters-angular/src/index.ts"],
      "@dashbuilder/exporters-vue": ["./packages/exporters-vue/src/index.ts"],
      "@dashbuilder/exporters-express": ["./packages/exporters-express/src/index.ts"],
      "@dashbuilder/exporters-next": ["./packages/exporters-next/src/index.ts"],
      "@dashbuilder/exporters-nuxt": ["./packages/exporters-nuxt/src/index.ts"],
      "@dashbuilder/exporters-svelte": ["./packages/exporters-svelte/src/index.ts"],
      "@dashbuilder/exporters-web-components": ["./packages/exporters-web-components/src/index.ts"],
      "@dashbuilder/web-components": ["./packages/web-components/src/index.ts"],
      "@dashbuilder/web-components/media": ["./packages/web-components/src/media/index.ts"],
      "@dashbuilder/web-components/wasm": ["./packages/web-components/src/wasm/index.ts"],
      "@dashbuilder/exporters-mongodb": ["./packages/exporters-mongodb/src/index.ts"],
      "@dashbuilder/exporters-mysql": ["./packages/exporters-mysql/src/index.ts"],
      "@dashbuilder/exporters-supabase": ["./packages/exporters-supabase/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
