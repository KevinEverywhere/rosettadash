{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@dashbuilder/core": ["./packages/core/src/index.ts"],
      "@dashbuilder/ui-primitives": ["./packages/ui-primitives/src/index.ts"],
      "@dashbuilder/exporters-react": ["./packages/exporters-react/src/index.ts"],
      "@dashbuilder/exporters-nest": ["./packages/exporters-nest/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
