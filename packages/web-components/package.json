{
  "name": "@rosettadash/web-components",
  "version": "0.0.1",
  "description": "RosettaDash Web Components runtime - default public UI package",
  "type": "module",
  "license": "MIT",
  "private": false,
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./layout/accordion": {
      "types": "./src/layout/accordion/index.d.ts",
      "import": "./src/layout/accordion/index.js",
      "default": "./src/layout/accordion/index.js"
    },
    "./media": {
      "types": "./src/media/index.d.ts",
      "import": "./src/media/index.js",
      "default": "./src/media/index.js"
    },
    "./wasm": {
      "types": "./src/wasm/index.d.ts",
      "import": "./src/wasm/index.js",
      "default": "./src/wasm/index.js"
    },
    "./visual/media/video-source": {
      "types": "./src/media/video-source.d.ts",
      "import": "./src/media/video-source.js",
      "default": "./src/media/video-source.js"
    },
    "./visual/media/equirect-viewport": {
      "types": "./src/media/equirect-viewport.d.ts",
      "import": "./src/media/equirect-viewport.js",
      "default": "./src/media/equirect-viewport.js"
    },
    "./tokens.css": "./styles/tokens.css",
    "./styles.css": "./styles/styles.css"
  },
  "files": [
    "src",
    "styles",
    "media",
    "README.md"
  ],
  "peerDependencies": {
    "@ffmpeg/ffmpeg": ">=0.12.0",
    "@ffmpeg/util": ">=0.12.0"
  },
  "peerDependenciesMeta": {
    "@ffmpeg/ffmpeg": {
      "optional": true
    },
    "@ffmpeg/util": {
      "optional": true
    }
  },
  "dependencies": {
    "@rosettadash/core": "*",
    "tslib": "^2.3.0"
  }
}
