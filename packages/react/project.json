{
  "name": "runtime-react",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/react/src",
  "projectType": "library",
  "tags": [
    "scope:runtime",
    "type:ui"
  ],
  "implicitDependencies": [
    "web-components"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/packages/react",
        "main": "packages/react/src/index.ts",
        "tsConfig": "packages/react/tsconfig.lib.json",
        "assets": [
          {
            "input": "packages/react",
            "glob": "README.md",
            "output": "."
          }
        ],
        "additionalEntryPoints": [
          "packages/react/src/domain/person-invite/index.ts",
          "packages/react/src/domain/role-assign/index.ts",
          "packages/react/src/domain/role-gate/index.ts",
          "packages/react/src/domain/time-preset/index.ts",
          "packages/react/src/infra/env/index.ts",
          "packages/react/src/infra/mongodb/index.ts",
          "packages/react/src/infra/mysql/index.ts",
          "packages/react/src/infra/postgresql/index.ts",
          "packages/react/src/infra/server/express/index.ts",
          "packages/react/src/infra/server/nest/index.ts",
          "packages/react/src/infra/server/next/index.ts",
          "packages/react/src/infra/server/nuxt/index.ts",
          "packages/react/src/infra/supabase/index.ts",
          "packages/react/src/infra/wasm/asset/index.ts",
          "packages/react/src/layout/accordion/index.ts",
          "packages/react/src/layout/accordion-link-list/index.ts",
          "packages/react/src/layout/collapsible/index.ts",
          "packages/react/src/layout/flex/index.ts",
          "packages/react/src/layout/grid/index.ts",
          "packages/react/src/layout/modal/index.ts",
          "packages/react/src/layout/tabs/index.ts",
          "packages/react/src/logic/timer/index.ts",
          "packages/react/src/visual/chart/bar/index.ts",
          "packages/react/src/visual/chart/line/index.ts",
          "packages/react/src/visual/chart/pie/index.ts",
          "packages/react/src/visual/detail/index.ts",
          "packages/react/src/visual/display/3d-bar-chart/index.ts",
          "packages/react/src/visual/display/3d-geo-globe/index.ts",
          "packages/react/src/visual/display/3d-gltf-model/index.ts",
          "packages/react/src/visual/display/3d-scatter/index.ts",
          "packages/react/src/visual/display/3d-scene/index.ts",
          "packages/react/src/visual/input/checkbox/index.ts",
          "packages/react/src/visual/input/date-range/index.ts",
          "packages/react/src/visual/input/number/index.ts",
          "packages/react/src/visual/input/select/index.ts",
          "packages/react/src/visual/input/text/index.ts",
          "packages/react/src/visual/input/textarea/index.ts",
          "packages/react/src/visual/kpi/index.ts",
          "packages/react/src/visual/link-list/index.ts",
          "packages/react/src/visual/media/equirect-viewport/index.ts",
          "packages/react/src/visual/media/live-capture/index.ts",
          "packages/react/src/visual/media/video-source/index.ts",
          "packages/react/src/visual/news/article-detail/index.ts",
          "packages/react/src/visual/news/language-select/index.ts",
          "packages/react/src/visual/news/region-select/index.ts",
          "packages/react/src/visual/news/results-table/index.ts",
          "packages/react/src/visual/news/search-box/index.ts",
          "packages/react/src/visual/news/type-select/index.ts",
          "packages/react/src/visual/plugin/metric-chip/index.ts",
          "packages/react/src/visual/plugin/status-badge/index.ts",
          "packages/react/src/visual/skeleton/index.ts",
          "packages/react/src/visual/svg/icon/index.ts",
          "packages/react/src/visual/svg/inline/index.ts",
          "packages/react/src/visual/table/index.ts",
          "packages/react/src/visual/wasm/media/index.ts",
          "packages/react/src/visual/wasm/module/index.ts",
          "packages/react/src/visual/wasm/worker-host/index.ts",
          "packages/react/src/wasm/wasm-media/index.ts"
        ],
        "generateExportsField": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p packages/react/tsconfig.lib.json"
      }
    }
  }
}
