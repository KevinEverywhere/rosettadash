{
  "name": "@rosettadash/svelte",
  "version": "0.0.1",
  "description": "RosettaDash Svelte 5 runtime — same import paths as @rosettadash/web-components. Storybook: github.com/KevinEverywhere/rosettadash (port 6010).",
  "author": "Kevin Ready <kevin@planetkevin.com>",
  "type": "module",
  "license": "MIT",
  "private": false,
  "svelte": "./src/layout/accordion/Accordion.svelte",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./layout/accordion": {
      "types": "./src/layout/accordion/types.d.ts",
      "svelte": "./src/layout/accordion/Accordion.svelte",
      "import": "./src/layout/accordion/Accordion.svelte",
      "default": "./src/layout/accordion/Accordion.svelte"
    },
    "./layout/accordion-link-list": {
      "types": "./src/layout/accordion-link-list/types.d.ts",
      "svelte": "./src/layout/accordion-link-list/AccordionLinkList.svelte",
      "import": "./src/layout/accordion-link-list/AccordionLinkList.svelte",
      "default": "./src/layout/accordion-link-list/AccordionLinkList.svelte"
    },
    "./visual/link-list": {
      "types": "./src/visual/link-list/types.d.ts",
      "svelte": "./src/visual/link-list/LinkList.svelte",
      "import": "./src/visual/link-list/LinkList.svelte",
      "default": "./src/visual/link-list/LinkList.svelte"
    },
    "./visual/media/video-source": {
      "types": "./src/visual/media/video-source/types.d.ts",
      "svelte": "./src/visual/media/video-source/VideoSource.svelte",
      "import": "./src/visual/media/video-source/VideoSource.svelte",
      "default": "./src/visual/media/video-source/VideoSource.svelte"
    },
    "./visual/media/equirect-viewport": {
      "types": "./src/visual/media/equirect-viewport/types.d.ts",
      "svelte": "./src/visual/media/equirect-viewport/EquirectViewport.svelte",
      "import": "./src/visual/media/equirect-viewport/EquirectViewport.svelte",
      "default": "./src/visual/media/equirect-viewport/EquirectViewport.svelte"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "dependencies": {
    "@rosettadash/web-components": "*",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
